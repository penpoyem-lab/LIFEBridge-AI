# LIFEBridge AI Backend Environment Configuration
APP_ENV=development
APP_SECRET_KEY=replace_with_secure_random_32_byte_secret_key
DATABASE_URL=sqlite:///./lifebridge.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/lifebridge_db

REDIS_URL=redis://localhost:6379/0
AI_PROVIDER=gemini
AI_API_KEY=replace_with_your_gemini_api_key
AI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=60

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=lifebridge-docs
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

ALLOWED_ORIGINS=*
MAX_UPLOAD_SIZE_MB=20
LOG_LEVEL=INFO
